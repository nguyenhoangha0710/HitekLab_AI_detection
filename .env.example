# Copy file nay thanh .env roi sua theo may cua ban (.env khong duoc commit).
#   PowerShell: Copy-Item .env.example .env
#   bash      : cp .env.example .env

# ----------------------------------------------------------------- che do chay
# "ai"  -> docker compose chay ca AI Service (YOLO + ByteTrack + Rule Engine) trong Docker.
# ""    -> khong chay AI Service trong Docker (tu chay tren may host, hoac chi xem video).
COMPOSE_PROFILES=ai

# viewer-ai: stream video + gui frame sang AI | viewer: chi stream video (khong can AI)
EDGE_MODE=viewer-ai

# Edge Gateway goi AI Service o dau:
#   AI trong Docker   : ws://ai-service:8003/ws/detect
#   AI chay tren host : ws://host.docker.internal:8003/ws/detect
AI_SERVICE_WS_URL=ws://ai-service:8003/ws/detect

# ------------------------------------------------------------ video camera gia lap
# Ten file trong code/data/videos/. Repo chi co san dummy_video_2.mp4;
# video demo khac lay tu thu muc chung cua nhom (xem HUONG_DAN_CHAY.md muc 3).
CAMERA1_VIDEO=dummy_video_2.mp4
CAMERA2_VIDEO=dummy_video_2.mp4

# ------------------------------------------------------------------- AI / YOLO
YOLO_MODEL=yolo11n.pt
YOLO_CLASSES=person,car,motorcycle
YOLO_CONFIDENCE=0.35
# cpu | 0 (GPU dau tien). Dung docker-compose.gpu.yml thi tu dat = 0.
YOLO_DEVICE=cpu
VIEWER_FPS=15
AI_FPS=5
RULE_CONFIG_TTL_SECONDS=10
RULE_EVENT_HEARTBEAT_SECONDS=10
RULE_TIMEZONE_OFFSET_HOURS=7

# ------------------------------------------------------------ canh bao / bang chung
EVIDENCE_INTERVAL_SECONDS=120
ALERT_RESOLVE_GRACE_SECONDS=30
EVIDENCE_VIDEO_ENABLED=true
EVIDENCE_STORAGE_BACKEND=minio

# ------------------------------------------------------- tai khoan / port (dev)
POSTGRES_DB=hitek_ai_iot
POSTGRES_USER=hitek_app
POSTGRES_PASSWORD=hitek_app_password
MINIO_ROOT_USER=hitek_minio
MINIO_ROOT_PASSWORD=hitek_minio_password
MINIO_BUCKET=hitek-evidence
TENANT_ID=demo-tenant

ZONE_SERVICE_PORT=8010
AI_SERVICE_PORT=8003
EDGE_GATEWAY_PORT=8002
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
RTSP_PORT=8554
