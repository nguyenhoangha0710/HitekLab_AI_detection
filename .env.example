# Copy file nay thanh .env roi sua theo may cua ban (.env khong duoc commit).
#   PowerShell: Copy-Item .env.example .env
#   bash      : cp .env.example .env

# ----------------------------------------------------------------- che do chay
# Danh sach profile bat them (cach nhau dau phay):
#   ai      -> AI Service (YOLO + ByteTrack + Rule Engine) chay trong Docker
#   backend -> Backend API .NET (code/backend) chay trong Docker
# Bo "backend" neu chua co code trong code/backend/ hoac dang chay Backend ngoai Docker (xem BACKEND_BASE_URL).
COMPOSE_PROFILES=ai,backend

# Doi nhanh noi chay AI (cpu | gpu | remote | off) bang: .\scripts\use-ai.ps1 <che-do>
# Che do gpu them 2 dong: COMPOSE_PATH_SEPARATOR=; va COMPOSE_FILE=docker-compose.yml;docker-compose.gpu.yml

# viewer-ai: stream video + gui frame sang AI | viewer: chi stream video (khong can AI)
EDGE_MODE=viewer-ai

# Edge Gateway goi AI Service o dau:
#   AI trong Docker   : ws://ai-service:8003/ws/detect
#   AI chay tren host : ws://host.docker.internal:8003/ws/detect
AI_SERVICE_WS_URL=ws://ai-service:8003/ws/detect

# ------------------------------------------------------------ video camera gia lap
# Ten file trong code/data/videos/. Repo chi co san dummy_video_2.mp4;
# video demo khac lay tu thu muc chung cua nhom (xem HUONG_DAN_CHAY.md muc 3).
CAMERA1_VIDEO=dummy_video_2.mp4
CAMERA2_VIDEO=dummy_video_2.mp4

# ------------------------------------------------------------------- AI / YOLO
YOLO_MODEL=yolo11n.pt
YOLO_CLASSES=person,car,motorcycle
YOLO_CONFIDENCE=0.35
# cpu | 0 (GPU dau tien). Dung docker-compose.gpu.yml thi tu dat = 0.
YOLO_DEVICE=cpu
VIEWER_FPS=15
AI_FPS=5
RULE_CONFIG_TTL_SECONDS=10
# Gui lai event dang active moi N giay (Risk Engine Backend chi giu nguon AI 3 giay).
RULE_EVENT_HEARTBEAT_SECONDS=1
RULE_TIMEZONE_OFFSET_HOURS=7
# Huong di chuyen: cua so tinh (giay) va nguong dung yen (ty le chieu rong khung hinh / giay).
MOTION_WINDOW_SECONDS=1.0
MOTION_STATIONARY_SPEED_RATIO=0.02

# ---------------------------------------------------------------- Backend API
# backend: Zone Service gui AI Event sang Backend (/api/v1/events), Backend + Risk Engine tao canh bao.
# local  : Zone Service tu gom alert nhu cu (chay thu khi chua co Backend).
ALERT_MODE=backend
# Zone Service goi Backend o dau:
#   Backend trong Docker (profile backend): http://backend:5250
#   Backend chay ngoai Docker (dotnet run) : http://host.docker.internal:5250
BACKEND_BASE_URL=http://backend:5250
# Project .NET de build (duong dan tinh tu code/backend/) va ten dll sau publish.
BACKEND_PROJECT=Backend.Api/Backend.Api.csproj
BACKEND_DLL=Backend.Api.dll
BACKEND_CLIENT_ID=ai-service
BACKEND_CLIENT_SECRET=ai-service-dev-secret
BACKEND_TIMEOUT_SECONDS=2

# ---------------------------------------------------------- phan quyen (tenant + location)
# off: khong dang nhap (dev) | jwt: xac thuc bang JWT do Backend cap, loc du lieu theo location.
AUTH_MODE=jwt
# true: dashboard co nut "Dang nhap demo" chon user demo (chi dung khi Backend chua co man hinh dang nhap).
AUTH_DEV_LOGIN=true
# Phai trung voi khoa ky JWT cua Backend (HS256). RS256: JWT_ALGORITHM=RS256 + JWT_PUBLIC_KEY_FILE.
JWT_ALGORITHM=HS256
JWT_SECRET=hitek-dev-jwt-secret-change-me-32chars
JWT_ISSUER=
JWT_AUDIENCE=
# Ten claim trong token: id user va tenant (tenant co the la id hoac code).
JWT_USER_CLAIM=sub
JWT_TENANT_CLAIM=tenant_id
# Khoa dung chung cho service noi bo (AI Service, Edge Gateway) goi Zone Service.
SERVICE_API_KEY=hitek-dev-service-key

# ------------------------------------------------------------ canh bao / bang chung
EVIDENCE_INTERVAL_SECONDS=120
ALERT_RESOLVE_GRACE_SECONDS=30
EVIDENCE_VIDEO_ENABLED=true
EVIDENCE_STORAGE_BACKEND=minio

# ------------------------------------------------------- tai khoan / port (dev)
POSTGRES_DB=hitek_ai_iot
POSTGRES_USER=hitek_app
POSTGRES_PASSWORD=hitek_app_password
MINIO_ROOT_USER=hitek_minio
MINIO_ROOT_PASSWORD=hitek_minio_password
MINIO_BUCKET=hitek-evidence
TENANT_ID=demo-tenant

ZONE_SERVICE_PORT=8010
BACKEND_PORT=5250
AI_SERVICE_PORT=8003
EDGE_GATEWAY_PORT=8002
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
RTSP_PORT=8554
